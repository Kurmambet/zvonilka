# Copy to backend/.env, replace credentials and JWT secret. Never commit .env.
ZVONILKA_DATABASE_URL=postgresql+asyncpg://zvonilka:CHANGE_ME@127.0.0.1:5432/zvonilka
ZVONILKA_DATABASE_SCHEMA=public
ZVONILKA_REDIS_URL=redis://127.0.0.1:6379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZVONILKA_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ZVONILKA_JWT_ISSUER=zvonilka
ZVONILKA_JWT_AUDIENCE=zvonilka-api-v1
ZVONILKA_ACCESS_TTL_SECONDS=600
ZVONILKA_REFRESH_TTL_SECONDS=1209600
ZVONILKA_MAX_SESSIONS_PER_USER=10
ZVONILKA_AUTH_BODY_LIMIT_BYTES=16384
ZVONILKA_DATABASE_POOL_SIZE=3


# =======
ZVONILKA_ROOM_REGISTRY_KEY=zvonilka:{rooms}:v1
ZVONILKA_ADMISSION_MODE=static
ZVONILKA_MAX_PARTICIPANTS_PER_ROOM=3
ZVONILKA_MAX_ACTIVE_ROOMS=2
ZVONILKA_MAX_ACTIVE_ROOMS_PER_USER=1
ZVONILKA_MAX_PENDING_ROOMS_PER_USER=3
ZVONILKA_ROOM_PENDING_TTL_SECONDS=86400
ZVONILKA_ROOM_EMPTY_GRACE_SECONDS=120
ZVONILKA_ROOM_MAX_LIFETIME_SECONDS=43200
ZVONILKA_INVITE_TTL_SECONDS=86400
ZVONILKA_ROOM_PRESENCE_TTL_SECONDS=45
ZVONILKA_ROOM_CLOSED_RETENTION_SECONDS=86400
ZVONILKA_ROOM_REGISTRY_MAX_RECORDS=128
ZVONILKA_ROOM_INVITES_PER_ROOM=32
# Requests per authenticated account: 12/hour, 120/min, 30/5min, 30/5min.
ZVONILKA_ROOM_CREATE_RATE_LIMIT=12
ZVONILKA_ROOM_READ_RATE_LIMIT=120
ZVONILKA_ROOM_WRITE_RATE_LIMIT=30
ZVONILKA_INVITE_REDEEM_RATE_LIMIT=30
