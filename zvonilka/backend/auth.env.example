# Copy to backend/.env, replace credentials and JWT secret. Never commit .env.
ZVONILKA_DATABASE_URL=postgresql+asyncpg://zvonilka:CHANGE_ME@127.0.0.1:5432/zvonilka
ZVONILKA_DATABASE_SCHEMA=public
ZVONILKA_REDIS_URL=redis://127.0.0.1:6379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZVONILKA_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
ZVONILKA_JWT_ISSUER=zvonilka
ZVONILKA_JWT_AUDIENCE=zvonilka-api-v1
ZVONILKA_ACCESS_TTL_SECONDS=600
ZVONILKA_REFRESH_TTL_SECONDS=1209600
ZVONILKA_MAX_SESSIONS_PER_USER=10
ZVONILKA_AUTH_BODY_LIMIT_BYTES=16384
ZVONILKA_DATABASE_POOL_SIZE=3
